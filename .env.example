# Copie para .env (fora do git) e ajuste os valores.

# PostgreSQL (container db)
POSTGRES_DB=erp_tea
POSTGRES_USER=erp_tea
POSTGRES_PASSWORD=troque-esta-senha

# Django (container backend)
DATABASE_URL=postgres://erp_tea:troque-esta-senha@db:5432/erp_tea
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
# "backend" é o host que chega pelo proxy do Next
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origem do navegador (Next), necessária para o CSRF passando pelo proxy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Next.js (container frontend): para onde o proxy /api encaminha
BACKEND_URL=http://backend:8000

TZ=America/Fortaleza
